# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/aika_db"

# Auth
JWT_SECRET="change-this-super-secret-jwt-key-in-production"
NEXTAUTH_SECRET="change-this-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# HuggingFace AI
HF_API_KEY="replace-with-your-huggingface-token"
HF_MODEL_PRIMARY="openai/gpt-oss-120b:fastest"
HF_MODEL_FALLBACK_1="deepseek-ai/DeepSeek-R1:fastest"
HF_MODEL_FALLBACK_2="mistralai/Mistral-7B-Instruct-v0.2:fastest"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
