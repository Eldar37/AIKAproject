generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        UserProfile?
  business       BusinessProfile?
  tasks          Task[]
  conversations  AIConversation[]
  progress       Progress?
  goals          Goal[]
  streaks        Streak?
  achievements   Achievement[]
  contentHistory ContentHistory[]
}

model UserProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl       String?
  timezone        String  @default("Asia/Bishkek")
  language        String  @default("ru")
  experienceLevel String  @default("beginner")
  xp              Int     @default(0)
  level           Int     @default(1)
}

model BusinessProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?
  niche          String?
  description    String?
  stage          String   @default("START")
  isOnline       Boolean  @default(true)
  budget         String?
  targetAudience String?
  channels       String[]
  firstSaleDone  Boolean  @default(false)
  monthlyRevenue Float?
  goals          String[]
  aiMode         String   @default("START_MODE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String
  status      String    @default("pending")
  priority    String    @default("medium")
  xpReward    Int       @default(10)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Progress {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStage   String   @default("START")
  stageProgress  Float    @default(0)
  totalScore     Float    @default(0)
  tasksCompleted Int      @default(0)
  daysActive     Int      @default(0)
  milestones     String[]
  updatedAt      DateTime @updatedAt
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String      @default("START_MODE")
  messages  AIMessage[]
  summary   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, completed])
}

model Streak {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current    Int      @default(0)
  longest    Int      @default(0)
  lastActive DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  icon        String?
  unlockedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId, unlockedAt])
}

model ContentHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  prompt    String
  result    String
  platform  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
